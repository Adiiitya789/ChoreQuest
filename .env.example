# Optional. Without these the app runs in guest mode and saves progress in this browser only.
# To turn on Google sign-in and cloud saves, copy this file to .env and fill in the values from
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# See FIREBASE_SETUP.md for the full steps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Coach backend: 'gemini' calls Gemini through Firebase AI Logic (enable Build -> AI Logic first); anything else uses the on-device engine.
VITE_COACH_BACKEND=gemini

# Optional App Check (reCAPTCHA v3 site key from Firebase console -> App Check).
VITE_RECAPTCHA_SITE_KEY=
